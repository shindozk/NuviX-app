{
  "expo": {
    "name": "NuviX",
    "slug": "nuvi-x",
    "version": "1.0.1",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070A08",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "UIRequiresFullScreen": true,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSCameraUsageDescription": "O app precisa da câmera para jogos compatíveis com AR.",
        "NSMicrophoneUsageDescription": "O app precisa do microfone para jogos com chat de voz.",
        "NSLocationWhenInUseUsageDescription": "O app pode usar a localização para jogos compatíveis."
      }
    },
    "android": {
      "package": "com.nuvix.app",
      "versionCode": 3,
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "backgroundColor": "#2B2C31",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.CAMERA",
        "android.permission.MICROPHONE"
      ],
      "predictiveBackGestureEnabled": false,
      "edgeToEdge": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#070A08",
      "theme": {
        "dark": true
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070A08",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-video",
      "expo-localization"
    ]
  }
}

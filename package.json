{
  "name": "nuvi-x",
  "version": "1.0.0",
  "description": "NuviX - Cloud Gaming player for Android with Material 3 Expressive design",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export:web",
    "build:android": "expo export --platform android",
    "generate:icons": "node scripts/make-icons.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "clean": "rm -rf node_modules .expo .expo-paths ./dist ./web-build",
    "reset": "rm -rf node_modules package-lock.json && npm install"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-localization": "~58.0.5",
    "expo-navigation-bar": "~58.0.4",
    "expo-screen-orientation": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "keywords": [
    "nuvi-x",
    "xbox",
    "cloud-gaming",
    "xbox-game-pass",
    "gaming",
    "react-native",
    "expo",
    "cloud",
    "streaming"
  ],
  "author": "NuviX Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/nuvi-x"
  },
  "private": true
}